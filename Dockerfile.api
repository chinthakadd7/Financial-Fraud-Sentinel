FROM python:3.11-slim-bookworm AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install only minimal runtime dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    libssl-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 appuser && \
    mkdir -p /app /app/logs && \
    chown -R appuser:appuser /app

WORKDIR /app

 
FROM base AS builder

# Install build tools ONLY here (not in final image)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.api.txt .

RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install --prefer-binary --default-timeout=180 --retries=5 -r requirements.api.txt

 
FROM base AS runtime

# Copy installed packages (FIXED path)
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy app code
COPY --chown=appuser:appuser src/ /app/src/
COPY --chown=appuser:appuser models_artifacts/ /app/models_artifacts/

# Environment file
RUN echo "API_HOST=0.0.0.0\nAPI_PORT=8000\nLOG_LEVEL=INFO" > /app/.env && \
    chown appuser:appuser /app/.env

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["python", "-m", "uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]